{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "electron-vite/node"],
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": [
    "electron.vite.config.*",
    "vitest.config.*",
    "playwright.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "e2e/**/*"
  ]
}
