{
  "name": "agentdeck",
  "version": "0.1.0",
  "description": "AgentDeck — a personal desktop workspace for AI coding agents",
  "main": "./out/main/index.js",
  "author": "Kanishak",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "dist": "npm run typecheck && electron-vite build && electron-builder --win",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.1",
    "@playwright/test": "1.64.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dockview-react": "8.6.1",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zustand": "5.0.15"
  }
}
